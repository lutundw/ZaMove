{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "LAB 8 (NEW FILE). Every JSON frame a browser sends is checked against this schema (same Opis library and style as Lab 4). additionalProperties:false = unknown keys are rejected.",
  "oneOf": [
    { "title": "hello",
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": { "type": { "const": "hello" }, "last_event_id": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 } } },
    { "title": "message",
      "type": "object", "additionalProperties": false, "required": ["type", "booking_id", "text"],
      "properties": { "type": { "const": "message" }, "booking_id": { "type": "integer", "minimum": 1 },
                      "text": { "type": "string", "minLength": 1, "maxLength": 500 } } },
    { "title": "status",
      "type": "object", "additionalProperties": false, "required": ["type", "booking_id", "status"],
      "properties": { "type": { "const": "status" }, "booking_id": { "type": "integer", "minimum": 1 },
                      "status": { "enum": ["accepted", "rejected", "confirmed", "in_transit", "completed", "cancelled"] } } },
    { "title": "ping",
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": { "type": { "const": "ping" } } }
  ]
}
