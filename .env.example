# ZaMove configuration (Lab 6). Copy this file to .env and fill in real values.
#   .env is listed in .gitignore and must NEVER be committed or uploaded.
# Best place for the real file on XAMPP: one folder ABOVE the project, named zamove.env
# (outside the web root), e.g. C:\xampp\htdocs\zamove.env is NOT safe, C:\xampp\zamove.env is.

# development | production | test (test = automated tests only)
ZAMOVE_ENV=development
# mysql (XAMPP) | sqlite (automated tests only)
ZAMOVE_DB_DRIVER=mysql
ZAMOVE_DB_HOST=localhost
ZAMOVE_DB_NAME=zamumove
# the limited account from schema.sql, not root
ZAMOVE_DB_USER=zamumove_app
# the password you chose in schema.sql
ZAMOVE_DB_PASS=

# At least 32 random characters. Generate one with:  php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
ZAMOVE_APP_KEY=

ZAMOVE_ALLOWED_HOSTS=localhost,127.0.0.1
# Hosts the server itself may call (payment gateway etc.). Empty = no outbound calls at all.
ZAMOVE_FETCH_ALLOWED_HOSTS=

# ---- Lab 8: WebSocket daemon (php ws/server.php) ----
ZAMOVE_WS_HOST=127.0.0.1
ZAMOVE_WS_PORT=8081
# pages that may open a WebSocket (CSWSH protection); use your real https origin
ZAMOVE_WS_ALLOWED_ORIGINS=https://localhost
ZAMOVE_WS_PING_SEC=25
ZAMOVE_WS_PONG_TIMEOUT=10
